   "source": [
    "## Parameter estimation\n",
    "Takes real S&P data and estimates mu and sigma using maximum lieklyhood estimation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "2fa03c2f-358c-4226-af3a-ce536f5c3888",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy import stats\n",
    "import yfinance as yf"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b63badac-2472-4c79-ad8f-d246b963d178",
   "metadata": {},
   "source": [
    "collects data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "e4b2bdb1-b837-47c7-bd00-e4a4732f1c9b",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "[*********************100%***********************]  1 of 1 completed"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Downloaded 1006 days of SPY data\n",
      "From : 2020-01-02\n",
      "To   : 2023-12-29\n",
      "Start price : $296.13\n",
      "End price   : $461.39\n"
     ]
    },
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "\n"
     ]
    }
   ],
   "source": [
    "ticker = \"SPY\"\n",
    "data   = yf.download(ticker, start=\"2020-01-01\", end=\"2024-01-01\")\n",
    "prices = data[\"Close\"] # takes only closing price\n",
    "\n",
    "print(f\"Downloaded {len(prices)} days of {ticker} data\")\n",
    "print(f\"From : {prices.index[0].date()}\")\n",
    "print(f\"To   : {prices.index[-1].date()}\")\n",
    "print(f\"Start price : ${prices.iloc[0].item():.2f}\")\n",
    "print(f\"End price   : ${prices.iloc[-1].item():.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bd45b777-16a2-4089-a91c-dc96694e11b5",
   "metadata": {},
   "source": [
    "calculates log return"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "03f9b451-812c-4114-880b-e8bcbe6d99db",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of log returns : 1005\n",
      "Mean daily log return : 0.000441\n",
      "Std  daily log return : 0.014315\n"
     ]
    }
   ],
   "source": [
    "log_returns = np.log(prices / prices.shift(1)).dropna() # log return of each trading day (close-to-close)\n",
    "\n",
    "print(f\"Number of log returns : {len(log_returns)}\")\n",
    "print(f\"Mean daily log return : {log_returns.mean().item():.6f}\")\n",
    "print(f\"Std  daily log return : {log_returns.std().item():.6f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "bcd69ee1-a61a-4275-826f-f0f7a06a61d9",
   "metadata": {},
   "source": [
    "carries out MLE on daily data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "005e92fe-5b6d-46da-9704-276b54b920b4",
   "metadata": {},
   "outputs": [],
   "source": [
    "mu_daily    = log_returns.mean().item() # daily log-return drift\n",
    "sigma_daily = log_returns.std().item() # daily log-return volitility"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7a074f40-b565-4df9-b320-351c0b992630",
   "metadata": {},
   "source": [
    "anualises estimates using log-return distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "96ed285f-76a1-48f9-bb31-04d928af6b2b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Parameter                 Value\n",
      "annual drift             0.1370\n",
      "annual volitility        0.2272\n"
     ]
    }
   ],
   "source": [
    "sigma_hat = sigma_daily * np.sqrt(252) # measured variance is sigma^2 * delta_t (1/252). rearrange to get annual std estime\n",
    "mu_hat    = mu_daily * 252 + 0.5 * sigma_hat**2  # measured mu is (mu- 1/2 *sigma^2) * delta_t. rearrange to get annual mu estimate\n",
    "\n",
    "print(f\"{'Parameter':20} {'Value':>10}\")\n",
    "print(f\"{'annual drift':20} {mu_hat:>10.4f}\")\n",
    "print(f\"{'annual volitility':20} {sigma_hat:>10.4f}\")"
   ]
  }
